diff --git a/src/Plugin/AiFunctionCall/GetCollectionsTool.php b/src/Plugin/AiFunctionCall/GetCollectionsTool.php
new file mode 100644
index 0000000..d584a13
--- /dev/null
+++ b/src/Plugin/AiFunctionCall/GetCollectionsTool.php
@@ -0,0 +1,479 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\search_api_typesense\Plugin\AiFunctionCall;
+
+use Drupal\ai\Attribute\FunctionCall;
+use Drupal\ai\Base\FunctionCallBase;
+use Drupal\ai\Service\FunctionCalling\StructuredExecutableFunctionCallInterface;
+use Drupal\ai\Utility\ContextDefinitionNormalizer;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Plugin\Context\ContextDefinition;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\search_api_typesense\Api\SearchApiTypesenseException;
+use Drupal\search_api_typesense\Api\TypesenseClientInterface;
+use Drupal\search_api_typesense\Entity\TypesenseSchemaInterface;
+use Drupal\search_api_typesense\Plugin\search_api\backend\SearchApiTypesenseBackend;
+use GuzzleHttp\Client;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Plugin implementation of Typesense Collections Fetch.
+ */
+#[FunctionCall(
+  id: 'search_api_typesense:get_collections',
+  function_name: 'typesense_get_collections',
+  name: 'Typesense Get Collections',
+  description: 'Retrieve available collections from Typesense server with metadata.',
+  group: 'information_tools',
+  context_definitions: [
+    'server_id' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup('Server ID'),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup('The Search API server ID configured for Typesense (optional).'),
+      required: FALSE,
+    ),
+    'include_schema' => new ContextDefinition(
+      data_type: 'boolean',
+      label: new TranslatableMarkup('Include Schema'),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup('Whether to include field schema information.'),
+      required: FALSE,
+      default_value: TRUE,
+    ),
+  ],
+)]
+final class GetCollectionsTool extends FunctionCallBase implements StructuredExecutableFunctionCallInterface {
+
+  /**
+   * The collections data.
+   *
+   * @var array<int, array<string, mixed>>
+   */
+  protected array $collections = [];
+
+  /**
+   * The server ID used.
+   *
+   * @var string
+   */
+  protected string $serverId = '';
+
+  /**
+   * Constructs a TypesenseGetCollectionsTool plugin.
+   *
+   * @param array<string, mixed> $configuration
+   *   A configuration array containing information about the plugin instance.
+   * @param string $plugin_id
+   *   The plugin_id for the plugin instance.
+   * @param mixed $plugin_definition
+   *   The plugin implementation definition.
+   * @param \Drupal\ai\Utility\ContextDefinitionNormalizer $normalizer
+   *   The context definition normalizer.
+   * @param \Drupal\Core\Config\ConfigFactoryInterface|null $configFactory
+   *   The config factory service.
+   * @param \Drupal\Core\Entity\EntityTypeManagerInterface|null $entityTypeManager
+   *   The entity type manager service.
+   * @param \GuzzleHttp\Client|null $httpClient
+   *   The HTTP client service.
+   * @param \Drupal\search_api_typesense\Api\TypesenseClientInterface|null $typesenseClient
+   *   The Typesense client service.
+   */
+  public function __construct(
+    array $configuration,
+    $plugin_id,
+    $plugin_definition,
+    ContextDefinitionNormalizer $normalizer,
+    protected readonly ?ConfigFactoryInterface $configFactory = NULL,
+    protected readonly ?EntityTypeManagerInterface $entityTypeManager = NULL,
+    protected readonly ?Client $httpClient = NULL,
+    protected ?TypesenseClientInterface $typesenseClient = NULL,
+  ) {
+    parent::__construct($configuration, $plugin_id, $plugin_definition, $normalizer);
+  }
+
+  /**
+   * Load from dependency injection container.
+   *
+   * @param \Symfony\Component\DependencyInjection\ContainerInterface $container
+   *   The dependency injection container.
+   * @param array<array-key, mixed> $configuration
+   *   A configuration array containing information about the plugin instance.
+   * @param string $plugin_id
+   *   The plugin_id for the plugin instance.
+   * @param mixed $plugin_definition
+   *   The plugin implementation definition.
+   *
+   * @return static
+   *   A new instance of this plugin.
+   */
+  public static function create(
+    ContainerInterface $container,
+    array $configuration,
+    $plugin_id,
+    $plugin_definition,
+  ): static {
+    $module_handler = $container->get('module_handler');
+    \assert($module_handler instanceof ModuleHandlerInterface);
+
+    $config_factory = $container->get('config.factory');
+    \assert($config_factory instanceof ConfigFactoryInterface);
+
+    $entity_type_manager = $container->get('entity_type.manager');
+    \assert($entity_type_manager instanceof EntityTypeManagerInterface);
+
+    $http_client = $container->get('http_client');
+    \assert($http_client instanceof Client);
+
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      new ContextDefinitionNormalizer($module_handler),
+      $config_factory,
+      $entity_type_manager,
+      $http_client,
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   *
+   * Executes the Typesense collections fetch function with the provided context
+   * values. Retrieves all collections from Search API indexes using Typesense
+   * backend with their metadata.
+   */
+  public function execute(): void {
+    // Collect the context values.
+    $server_id = $this->getContextValue('server_id');
+    $include_schema = (bool) $this->getContextValue('include_schema');
+
+    try {
+      // Fetch collections from Search API indexes instead of Typesense server.
+      $collections_data = $this->fetchCollectionsFromTypesense($include_schema, $server_id);
+
+      if ($collections_data === []) {
+        $server_message = \is_string($server_id) && $server_id !== ''
+          ? "server '{$server_id}'"
+          : "any Typesense servers";
+        $this->setOutput("No collections found in {$server_message}.");
+
+        return;
+      }
+
+      $this->formatResults($collections_data);
+    }
+    catch (SearchApiTypesenseException $e) {
+      $this->setOutput("Failed to fetch collections: " . $e->getMessage());
+    }
+  }
+
+  /**
+   * Fetch collections from Search API indexes using Typesense backend.
+   *
+   * Retrieves all Search API indexes that use the Typesense backend and
+   * optionally includes detailed schema information for each collection.
+   *
+   * @param bool $include_schema
+   *   Whether to include field schema information.
+   * @param string|null $server_id
+   *   Optional server ID to filter by specific server.
+   *
+   * @return array<int, array<string, mixed>>
+   *   Array of collection data.
+   *
+   * @throws \Drupal\search_api_typesense\Api\SearchApiTypesenseException
+   *   When collections cannot be retrieved.
+   */
+  private function fetchCollectionsFromTypesense(bool $include_schema, ?string $server_id = NULL): array {
+    if ($this->entityTypeManager === NULL) {
+      throw new SearchApiTypesenseException('Entity type manager is not available.');
+    }
+
+    $collections = [];
+
+    try {
+      // Load all Search API indexes.
+      $indexes = $this->entityTypeManager
+        ->getStorage('search_api_index')
+        ->loadMultiple();
+
+      /** @var \Drupal\search_api\Entity\Index $index */
+      foreach ($indexes as $index) {
+        $server = $index->getServerInstance();
+
+        // Check if the server uses SearchApiTypesenseBackend.
+        if ($server === NULL || !($server->getBackend() instanceof SearchApiTypesenseBackend)) {
+          continue;
+        }
+
+        // If a specific server ID is requested, filter by it.
+        if ($server_id !== NULL && $server->id() !== $server_id) {
+          continue;
+        }
+
+        // Get the collection name from the backend.
+        /** @var \Drupal\search_api_typesense\Plugin\search_api\backend\SearchApiTypesenseBackend $backend */
+        $backend = $server->getBackend();
+        $collection_name = $backend->getCollectionName($index);
+
+        // Get schema information if requested.
+        $schema_info = [];
+        $fields = [];
+        $embedding_fields = [];
+        $text_fields = [];
+        $num_documents = 0;
+
+        if ($include_schema) {
+          $schema = $backend->getSchemaForIndex($index);
+          if ($schema instanceof TypesenseSchemaInterface) {
+            $schema_data = $schema->getSchema();
+            $schema_info = $schema_data['fields'] ?? [];
+
+            // Extract field information from the schema.
+            foreach ($schema_info as $field) {
+              if (isset($field['name'])) {
+                $fields[] = $field['name'];
+
+                // Identify embedding fields (float[] with embed config).
+                if (isset($field['type']) && $field['type'] === 'float[]' && isset($field['embed'])) {
+                  $embedding_fields[] = $field['name'];
+                }
+
+                // Identify text fields.
+                if (isset($field['type']) && \in_array($field['type'], ['string', 'string[]'], TRUE) && !isset($field['embed'])) {
+                  $text_fields[] = $field['name'];
+                }
+              }
+            }
+          }
+
+          // Try to get document count from the collection if possible.
+          try {
+            if (\method_exists($backend, 'getTypesenseClient')) {
+              // @phpstan-ignore-next-line
+              $client = $backend->getTypesenseClient();
+              $collection_info = $client->retrieveCollectionInfo($collection_name);
+              if ($collection_info !== NULL) {
+                $num_documents = $collection_info['num_documents'] ?? 0;
+              }
+            }
+          }
+          catch (\Exception $e) {
+            // Ignore errors when fetching document count.
+            $num_documents = 0;
+          }
+        }
+
+        $collections[] = [
+          'name' => $collection_name,
+          'description' => $this->generateCollectionDescriptionFromIndex($index, $fields, $embedding_fields, $num_documents),
+          'keywords' => $this->extractKeywordsFromIndex($index, $fields),
+          'num_documents' => $num_documents,
+          'created_at' => NULL,
+          'fields' => $fields,
+          'embedding_fields' => $embedding_fields,
+          'text_fields' => $text_fields,
+          'has_embeddings' => !($embedding_fields === []),
+          'schema' => $include_schema ? $schema_info : [],
+          'index_id' => $index->id(),
+          'index_label' => $index->label(),
+          'server_id' => $server->id(),
+          'server_label' => $server->label(),
+        ];
+      }
+    }
+    catch (\Exception $e) {
+      throw new SearchApiTypesenseException('Failed to fetch collections from Search API indexes: ' . $e->getMessage());
+    }
+
+    return $collections;
+  }
+
+  /**
+   * Generate a description for a collection based on index metadata.
+   *
+   * Creates a human-readable description of the collection based on the
+   * index information, field types, and embedding capabilities.
+   *
+   * @param \Drupal\search_api\IndexInterface $index
+   *   The Search API index.
+   * @param array<int, string> $fields
+   *   Array of field names.
+   * @param array<int, string> $embedding_fields
+   *   Array of embedding field names.
+   * @param int $num_documents
+   *   Number of documents in the collection.
+   *
+   * @return string
+   *   A generated description.
+   */
+  private function generateCollectionDescriptionFromIndex($index, array $fields, array $embedding_fields, int $num_documents): string {
+    $collection_name = $index->label();
+    $description = "Collection '{$collection_name}' contains {$num_documents} documents";
+
+    if (!($embedding_fields === [])) {
+      $description .= " with semantic search capabilities";
+    }
+
+    if (!($fields === [])) {
+      $field_list = \array_slice($fields, 0, 5);
+      $description .= " with fields: " . \implode(', ', $field_list);
+      if (\count($fields) > 5) {
+        $description .= " and " . (\count($fields) - 5) . " more";
+      }
+    }
+
+    return $description;
+  }
+
+  /**
+   * Extract keywords from index metadata.
+   *
+   * Generates keywords based on index name and field names to help
+   * AI agents understand what type of content is stored in the collection.
+   *
+   * @param \Drupal\search_api\IndexInterface $index
+   *   The Search API index.
+   * @param array<int, string> $fields
+   *   Array of field names.
+   *
+   * @return array<int<0, max>|string, string>
+   *   Array of keywords.
+   */
+  private function extractKeywordsFromIndex($index, array $fields): array {
+    $keywords = [];
+
+    // Use index ID and label as base keywords.
+    $keywords[] = (string) $index->id();
+    $keywords[] = (string) $index->label();
+
+    // Extract keywords from index name segments.
+    $name_parts = \preg_split('/[_\-\s]+/', (string) $index->id());
+    if ($name_parts !== FALSE) {
+      $keywords = \array_merge($keywords, $name_parts);
+    }
+
+    $label_parts = \preg_split('/[_\-\s]+/', (string) $index->label());
+    if ($label_parts !== FALSE) {
+      $keywords = \array_merge($keywords, $label_parts);
+    }
+
+    // Extract keywords from field names.
+    foreach ($fields as $field) {
+      // Convert field names to readable keywords.
+      $field_keywords = \preg_split('/[_\-\s]+/', $field);
+      if ($field_keywords !== FALSE) {
+        $keywords = \array_merge($keywords, $field_keywords);
+      }
+    }
+
+    // Add entity types as keywords.
+    $entity_types = $index->getEntityTypes();
+    $keywords = \array_merge($keywords, $entity_types);
+
+    // Clean up and remove duplicates.
+    $keywords = \array_filter($keywords, static function ($keyword) {
+      // Remove very short keywords.
+      return \strlen($keyword) > 2;
+    });
+
+    return \array_unique($keywords);
+  }
+
+  /**
+   * Format collections results for AI agent consumption.
+   *
+   * Processes the collections data and formats it into a readable format
+   * for AI agents, including summaries and capabilities information.
+   *
+   * @param array<int, array<string, mixed>> $collections
+   *   The collections data from Typesense.
+   */
+  private function formatResults(array $collections): void {
+    $this->collections = $collections;
+    $formatted_results = [];
+
+    if ($collections === []) {
+      $this->setOutput("No collections found in Typesense server '{$this->serverId}'.");
+      return;
+    }
+
+    $formatted_results[] = "Available Typesense collections from Search API indexes:\n";
+
+    foreach ($collections as $collection) {
+      $result_text = "Collection: {$collection['name']}\n";
+      $result_text .= "Description: {$collection['description']}\n";
+      $result_text .= "Search API Index: {$collection['index_label']} (ID: {$collection['index_id']})\n";
+      $result_text .= "Server: {$collection['server_label']} (ID: {$collection['server_id']})\n";
+      $result_text .= "Documents: {$collection['num_documents']}\n";
+
+      if (isset($collection['has_embeddings']) && (bool) $collection['has_embeddings']) {
+        $result_text .= "Semantic Search: Yes (fields: " . \implode(', ', $collection['embedding_fields']) . ")\n";
+      }
+      else {
+        $result_text .= "Semantic Search: No\n";
+      }
+
+      if (isset($collection['text_fields']) && $collection['text_fields'] !== []) {
+        $result_text .= "Text Fields: " . \implode(', ', \array_slice($collection['text_fields'], 0, 5));
+        if (\count($collection['text_fields']) > 5) {
+          $result_text .= " and " . (\count($collection['text_fields']) - 5) . " more";
+        }
+        $result_text .= "\n";
+      }
+
+      if (isset($collection['keywords']) && $collection['keywords'] !== []) {
+        $result_text .= "Keywords: " . \implode(', ', \array_slice($collection['keywords'], 0, 10));
+        if (\count($collection['keywords']) > 10) {
+          $result_text .= " and more";
+        }
+        $result_text .= "\n";
+      }
+
+      if (isset($collection['created_at']) && \is_string($collection['created_at'])) {
+        $result_text .= "Created: {$collection['created_at']}\n";
+      }
+
+      $formatted_results[] = $result_text;
+    }
+
+    $output = \implode("\n", $formatted_results);
+    $this->setOutput($output);
+  }
+
+  /**
+   * {@inheritdoc}
+   *
+   * Returns structured output containing collections data and server info
+   * for programmatic access.
+   *
+   * @return array<string, mixed>
+   *   The structured output data.
+   */
+  public function getStructuredOutput(): array {
+    return [
+      'collections' => $this->collections,
+      'total_collections' => \count($this->collections),
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   *
+   * Sets structured output data from a provided array, typically used
+   * for restoring state from serialized data.
+   *
+   * @param array<array-key, mixed> $output
+   *   The structured output data containing collections, server_id,
+   *   and total_collections.
+   */
+  public function setStructuredOutput(array $output): void {
+    $this->collections = $output['collections'] ?? [];
+  }
+
+}
diff --git a/src/Plugin/AiFunctionCall/TypesenseRagTool.php b/src/Plugin/AiFunctionCall/TypesenseRagTool.php
new file mode 100644
index 0000000..a59d2d3
--- /dev/null
+++ b/src/Plugin/AiFunctionCall/TypesenseRagTool.php
@@ -0,0 +1,664 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\search_api_typesense\Plugin\AiFunctionCall;
+
+use Drupal\ai\Attribute\FunctionCall;
+use Drupal\ai\Base\FunctionCallBase;
+use Drupal\ai\Service\FunctionCalling\StructuredExecutableFunctionCallInterface;
+use Drupal\ai\Utility\ContextDefinitionNormalizer;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Language\LanguageInterface;
+use Drupal\Core\Language\LanguageManagerInterface;
+use Drupal\Core\Plugin\Context\ContextDefinition;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\search_api_typesense\Api\SearchApiTypesenseException;
+use Drupal\search_api_typesense\Api\TypesenseClientInterface;
+use Drupal\search_api_typesense\Enum\SearchType;
+use Drupal\search_api_typesense\Plugin\search_api\backend\SearchApiTypesenseBackend;
+use GuzzleHttp\Client;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Plugin implementation of Typesense RAG Search.
+ */
+#[FunctionCall(
+  id: 'search_api_typesense:rag_search',
+  function_name: 'typesense_rag_search',
+  name: 'Typesense RAG/Vector Search',
+  description: 'Search the relevant website contents in the selected Typesense collection using semantic/vector search.',
+  group: 'information_tools',
+  context_definitions: [
+    'collection_names' => new ContextDefinition(
+      data_type: "string",
+      label: new TranslatableMarkup('Collection names'),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup('The names of the Typesense collections to search in.'),
+      required: TRUE,
+    ),
+    'search_query' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup('Search Query'),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup('The search query/prompt for semantic search.'),
+      required: TRUE,
+    ),
+    'search_type' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup('Search Type'),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup("Type of search: 'semantic' (default) or 'hybrid'."),
+      required: FALSE,
+      default_value: 'semantic',
+    ),
+    'amount' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup("Amount"),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup("Number of results to return."),
+      required: FALSE,
+      default_value: 10,
+    ),
+    'distance_threshold' => new ContextDefinition(
+      data_type: 'string',
+      label: new TranslatableMarkup("Distance Threshold"),
+      /* @phpstan-ignore-next-line */
+      description: new TranslatableMarkup("Maximum vector distance threshold (0.0-2.0)."),
+      required: FALSE,
+      default_value: 1.0,
+    ),
+  ],
+)]
+final class TypesenseRagTool extends FunctionCallBase implements StructuredExecutableFunctionCallInterface {
+
+  /**
+   * The search results.
+   *
+   * @var array<int, array<string, mixed>>
+   */
+  protected array $results = [];
+
+  /**
+   * The collection names.
+   *
+   * @var string[]
+   */
+  protected array $collectionNames = [];
+
+  /**
+   * The search query.
+   *
+   * @var string
+   */
+  protected string $searchQuery = '';
+
+  /**
+   * The language code field in the collection, if any.
+   *
+   * If it's set, we will filter results to the current language.
+   *
+   * @var string|null
+   */
+  protected ?string $langcodeField = NULL;
+
+  /**
+   * The Typesense client for making API calls.
+   *
+   * @var \Drupal\search_api_typesense\Api\TypesenseClientInterface|null
+   */
+  protected ?TypesenseClientInterface $typesenseClient = NULL;
+
+  /**
+   * Constructs a TypesenseRagTool plugin.
+   *
+   * @param array<string, mixed> $configuration
+   *   A configuration array containing information about the plugin instance.
+   * @param string $plugin_id
+   *   The plugin_id for the plugin instance.
+   * @param mixed $plugin_definition
+   *   The plugin implementation definition.
+   * @param \Drupal\ai\Utility\ContextDefinitionNormalizer $normalizer
+   *   The context definition normalizer.
+   * @param \Drupal\Core\Language\LanguageManagerInterface $languageManager
+   *   The language manager service.
+   * @param \Drupal\Core\Config\ConfigFactoryInterface|null $configFactory
+   *   The config factory service.
+   * @param \Drupal\Core\Entity\EntityTypeManagerInterface|null $entityTypeManager
+   *   The entity type manager service.
+   * @param \GuzzleHttp\Client|null $httpClient
+   *   The HTTP client service.
+   */
+  public function __construct(
+    array $configuration,
+    $plugin_id,
+    $plugin_definition,
+    ContextDefinitionNormalizer $normalizer,
+    private readonly LanguageManagerInterface $languageManager,
+    protected readonly ?ConfigFactoryInterface $configFactory = NULL,
+    protected readonly ?EntityTypeManagerInterface $entityTypeManager = NULL,
+    protected readonly ?Client $httpClient = NULL,
+  ) {
+    parent::__construct($configuration, $plugin_id, $plugin_definition, $normalizer);
+  }
+
+  /**
+   * Load from dependency injection container.
+   *
+   * @param \Symfony\Component\DependencyInjection\ContainerInterface $container
+   *   The dependency injection container.
+   * @param array<array-key, mixed> $configuration
+   *   A configuration array containing information about the plugin instance.
+   * @param string $plugin_id
+   *   The plugin_id for the plugin instance.
+   * @param mixed $plugin_definition
+   *   The plugin implementation definition.
+   *
+   * @return static
+   *   A new instance of this plugin.
+   */
+  public static function create(
+    ContainerInterface $container,
+    array $configuration,
+    $plugin_id,
+    $plugin_definition,
+  ): static {
+    $module_handler = $container->get('module_handler');
+    \assert($module_handler instanceof ModuleHandlerInterface);
+
+    $language_manager = $container->get('language_manager');
+    \assert($language_manager instanceof LanguageManagerInterface);
+
+    $config_factory = $container->get('config.factory');
+    \assert($config_factory instanceof ConfigFactoryInterface);
+
+    $entity_type_manager = $container->get('entity_type.manager');
+    \assert($entity_type_manager instanceof EntityTypeManagerInterface);
+
+    $http_client = $container->get('http_client');
+    \assert($http_client instanceof Client);
+
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      new ContextDefinitionNormalizer($module_handler),
+      $language_manager,
+      $config_factory,
+      $entity_type_manager,
+      $http_client,
+    );
+  }
+
+  /**
+   * Initialize the Typesense client from existing backend configurations.
+   *
+   * Searches for existing Search API Typesense server configurations and
+   * initializes the Typesense client from the first available server.
+   *
+   * @throws \Drupal\search_api_typesense\Api\SearchApiTypesenseException
+   *   When no Typesense servers are found or client cannot be initialized.
+   */
+  private function initializeTypesenseClient(): void {
+    // If client is already injected (e.g., in tests), skip initialization.
+    if ($this->typesenseClient !== NULL) {
+      return;
+    }
+
+    // Ensure we have required services.
+    if ($this->entityTypeManager === NULL) {
+      throw new SearchApiTypesenseException('Entity type manager is not available.');
+    }
+
+    // Look for existing Typesense backend configurations.
+    $servers = $this->entityTypeManager
+      ->getStorage('search_api_server')
+      ->loadByProperties(['backend' => 'search_api_typesense']);
+
+    if ($servers === [] || $servers === NULL) {
+      throw new SearchApiTypesenseException('No Search API Typesense servers found.');
+    }
+
+    // Use the first available server's configuration.
+    // @todo We have to improve this to allow selecting a specific server, or
+    //   allow multiple servers.
+    /** @var \Drupal\search_api\Entity\Server $server */
+    $server = \reset($servers);
+    $backend = $server->getBackend();
+    \assert($backend instanceof SearchApiTypesenseBackend);
+    $typesense_client = $backend->getTypesenseClient();
+    $this->setTypesenseClient($typesense_client);
+  }
+
+  /**
+   * Sets the Typesense client (primarily for testing purposes).
+   *
+   * @param \Drupal\search_api_typesense\Api\TypesenseClientInterface $client
+   *   The Typesense client to use.
+   */
+  public function setTypesenseClient(TypesenseClientInterface $client): void {
+    $this->typesenseClient = $client;
+  }
+
+  /**
+   * {@inheritdoc}
+   *
+   * Executes the Typesense RAG search function with the provided context
+   * values. Initializes the Typesense client, retrieves collection information,
+   * and performs either semantic or hybrid search based on the search type.
+   */
+  public function execute(): void {
+    // Collect the context values.
+    $this->collectionNames = \explode(',', (string) $this->getContextValue('collection_names'));
+    $this->searchQuery = $this->getContextValue('search_query');
+    $search_type_value = $this->getContextValue('search_type');
+    $amount = (int) $this->getContextValue('amount');
+    $distance_threshold = (float) $this->getContextValue('distance_threshold');
+
+    try {
+      // Initialize Typesense client if not already done.
+      if ($this->typesenseClient === NULL) {
+        $this->initializeTypesenseClient();
+      }
+
+      // Ensure we have a valid client after initialization.
+      if ($this->typesenseClient === NULL) {
+        $this->setOutput("Failed to initialize Typesense client. Please ensure a Typesense server is configured.");
+        return;
+      }
+
+      // Convert search type string to enum.
+      $search_type = SearchType::tryFromString($search_type_value);
+      if ($search_type === NULL) {
+        $search_type = SearchType::default();
+      }
+
+      // Perform search based on type.
+      $results = $this->doSearch($search_type, $amount, $distance_threshold);
+
+      $this->formatResults($results);
+    }
+    catch (SearchApiTypesenseException $e) {
+      $this->setOutput("Failed to search the collection: " . $e->getMessage());
+    }
+  }
+
+  /**
+   * Get collection information and schema.
+   *
+   * Retrieves the collection information from Typesense, including the schema
+   * definition with field types and configurations.
+   *
+   * @param string $collection_name
+   *   The name of the Typesense collection.
+   *
+   * @return array<string, mixed>|null
+   *   The collection information array, or NULL if collection not found.
+   */
+  private function getCollectionInfo(string $collection_name): ?array {
+    if ($this->typesenseClient === NULL) {
+      return NULL;
+    }
+
+    try {
+      return $this->typesenseClient->retrieveCollectionInfo($collection_name);
+    }
+    catch (SearchApiTypesenseException $e) {
+      return NULL;
+    }
+  }
+
+  /**
+   * Extract embedding fields from collection schema.
+   *
+   * Analyzes the collection schema to identify fields that are configured
+   * with auto-embedding for semantic search capabilities.
+   *
+   * @param array<string, mixed> $collection_info
+   *   The collection information array containing field definitions.
+   *
+   * @return array<string, mixed>
+   *   An associative array of embedding field names to their embed configs.
+   */
+  private function getEmbeddingFields(array $collection_info): array {
+    $embedding_fields = [];
+
+    if (!isset($collection_info['fields'])) {
+      return $embedding_fields;
+    }
+
+    foreach ($collection_info['fields'] as $field) {
+      if (isset($field['type']) && $field['type'] === 'float[]' && isset($field['embed'])) {
+        $embedding_fields[$field['name']] = $field['embed'];
+      }
+    }
+
+    return $embedding_fields;
+  }
+
+  /**
+   * Extracts the langcode field from the collection schema if present.
+   *
+   * Scans the collection schema for a field of type 'string' that is marked
+   * with the 'langcode' property, indicating it stores language information.
+   *
+   * @param array<string, mixed> $collection_info
+   *   The collection information array containing field definitions.
+   *
+   * @return string|null
+   *   The name of the langcode field if found, or NULL otherwise.
+   */
+  private function getLangcodeField(array $collection_info): ?string {
+    if (!isset($collection_info['fields'])) {
+      return NULL;
+    }
+
+    foreach ($collection_info['fields'] as $field) {
+      if (isset($field['type']) && $field['type'] === 'string' && isset($field['name']) && $field['name'] === 'langcode') {
+        return $field['name'];
+      }
+    }
+
+    return NULL;
+  }
+
+  /**
+   * Get text fields from collection schema.
+   *
+   * Identifies text fields in the collection schema that are suitable for
+   * keyword search in hybrid search scenarios.
+   *
+   * @param array<string, mixed> $collection_info
+   *   The collection information array containing field definitions.
+   *
+   * @return array<int, string>
+   *   An indexed array of text field names.
+   */
+  private function getTextFields(array $collection_info): array {
+    $text_fields = [];
+
+    if (!isset($collection_info['fields'])) {
+      return $text_fields;
+    }
+
+    foreach ($collection_info['fields'] as $field) {
+      if (isset($field['type']) && \in_array($field['type'], ['string', 'string[]'], TRUE) &&
+          !isset($field['embed'])) {
+        $text_fields[] = $field['name'];
+      }
+    }
+
+    return $text_fields;
+  }
+
+  /**
+   * Execute the search with proper parameter handling for semantic or hybrid.
+   *
+   * This method handles:
+   * - Collection info retrieval for all collections (single or multiple)
+   * - Field discovery (embedding and text fields) from all collections
+   * - Search parameter construction based on search type
+   * - Vector query configuration
+   * - Language filtering
+   * - Federated search for multiple collections.
+   *
+   * @param \Drupal\search_api_typesense\Enum\SearchType $search_type
+   *   The type of search: Semantic or Hybrid.
+   * @param int $amount
+   *   Number of results to return.
+   * @param float $distance_threshold
+   *   Maximum vector distance threshold (0.0-2.0).
+   *
+   * @return array<int, array<string, mixed>>
+   *   The search results from Typesense.
+   *
+   * @throws \Drupal\search_api_typesense\Api\SearchApiTypesenseException
+   *   When client is unavailable or no embedding fields found.
+   */
+  private function doSearch(SearchType $search_type, int $amount, float $distance_threshold): array {
+    if ($this->typesenseClient === NULL) {
+      throw new SearchApiTypesenseException('Typesense client is not available.');
+    }
+
+    if ($this->collectionNames === []) {
+      throw new SearchApiTypesenseException('No collection names provided for search.');
+    }
+
+    // Gather field information from all collections.
+    $all_embedding_fields = [];
+    $all_text_fields = [];
+    $langcode_field = NULL;
+
+    foreach ($this->collectionNames as $collection_name) {
+      $collection_info = $this->getCollectionInfo($collection_name);
+      if ($collection_info === NULL) {
+        throw new SearchApiTypesenseException("Collection '{$collection_name}' not found.");
+      }
+
+      // Extract embedding fields from this collection.
+      $embedding_fields = $this->getEmbeddingFields($collection_info);
+      $all_embedding_fields = \array_merge($all_embedding_fields, $embedding_fields);
+
+      // Extract text fields for hybrid search.
+      if ($search_type === SearchType::Hybrid) {
+        $text_fields = $this->getTextFields($collection_info);
+        $all_text_fields = \array_merge($all_text_fields, $text_fields);
+      }
+
+      // Get langcode field (use the first one found).
+      if ($langcode_field === NULL) {
+        $langcode_field = $this->getLangcodeField($collection_info);
+      }
+    }
+
+    // Ensure we have embedding fields for RAG search.
+    if ($all_embedding_fields === []) {
+      throw new SearchApiTypesenseException('No auto-embedding fields configured. RAG search requires embedding fields.');
+    }
+
+    $this->langcodeField = $langcode_field;
+
+    // Build query_by fields: remove duplicates across collections.
+    $query_by_fields = \array_unique(\array_keys($all_embedding_fields));
+    if ($search_type === SearchType::Hybrid) {
+      $query_by_fields = \array_unique(\array_merge($query_by_fields, $all_text_fields));
+    }
+
+    // Build base search parameters.
+    $search_params = [
+      'q' => $this->searchQuery,
+      'query_by' => \implode(',', $query_by_fields),
+      'per_page' => $amount,
+      'exclude_fields' => \implode(',', \array_unique(\array_keys($all_embedding_fields))),
+    ];
+
+    // Add language filter if applicable.
+    if ($this->langcodeField !== NULL) {
+      $language = $this->languageManager->getCurrentLanguage(LanguageInterface::TYPE_CONTENT);
+      $search_params['filter_by'] = "{$this->langcodeField}:=" . $language->getId();
+    }
+
+    // Add search-type-specific parameters.
+    if ($search_type === SearchType::Semantic) {
+      // Disable prefix matching for semantic search - we need full query
+      // context for accurate embedding generation.
+      $search_params['prefix'] = 'false';
+    }
+    else {
+      // For hybrid search, disable token dropping to preserve full query
+      // context for both semantic and keyword matching.
+      $search_params['drop_tokens_threshold'] = 0;
+    }
+
+    // Add vector query configuration with distance threshold.
+    if ($distance_threshold < 2.0) {
+      $vector_queries = [];
+      foreach ($all_embedding_fields as $field_name => $config) {
+        $vector_queries[] = "{$field_name}:([], distance_threshold:{$distance_threshold})";
+      }
+      $search_params['vector_query'] = \implode(',', $vector_queries);
+    }
+
+    // Execute search: single collection or federated multi-collection.
+    $collection_count = \count($this->collectionNames);
+    $results = match ($collection_count) {
+      1 => $this->typesenseClient->searchDocuments(
+        $this->collectionNames[0],
+        $search_params,
+      ),
+      default => $this->typesenseClient->searchDocumentsWithFederation(
+        $this->collectionNames,
+        $search_params,
+      ),
+    };
+
+    // Transform federated search results into single search format.
+    // Federated search returns: { "results": [{ "hits": [...] }, ...] }
+    // We need to flatten it to: { "hits": [...] }.
+    if ($collection_count > 1 && isset($results['results'])) {
+      $merged_hits = [];
+      foreach ($results['results'] as $result) {
+        if (isset($result['hits']) && \is_array($result['hits'])) {
+          $merged_hits = \array_merge($merged_hits, $result['hits']);
+        }
+      }
+      $results = ['hits' => $merged_hits];
+    }
+
+    return $results;
+  }
+
+  /**
+   * Format search results for AI agent consumption.
+   *
+   * Processes the raw search results from Typesense and formats them into
+   * a readable format for AI agents, including content extraction and
+   * vector distance information.
+   *
+   * @param array<int, array<string, mixed>> $results
+   *   The raw search results from Typesense.
+   */
+  private function formatResults(array $results): void {
+    $this->results = [];
+    $formatted_results = [];
+
+    if ($results === [] || !isset($results['hits']) || $results['hits'] === []) {
+      $collections_str = \implode("', '", $this->collectionNames);
+      $this->setOutput("No results found for query '{$this->searchQuery}' in collection(s) '{$collections_str}'.");
+      return;
+    }
+
+    $i = 1;
+    foreach ($results['hits'] as $result) {
+      // Extract document data.
+      $document = $result['document'] ?? [];
+      $vector_distance = $result['vector_distance'] ?? NULL;
+
+      // Build content from available fields, excluding embedding fields.
+      $content = $this->extractDocumentContent($document);
+
+      if ($content !== '') {
+        $result_text = "Search result #$i:\n```\n" . $content . "\n```\n";
+
+        // Add vector distance info if available.
+        if ($vector_distance !== NULL) {
+          $result_text .= "Vector distance: " . \round($vector_distance, 4) . "\n";
+        }
+
+        $formatted_results[] = $result_text;
+
+        // Store structured result for getStructuredOutput.
+        $this->results[] = [
+          'content' => $content,
+          'vector_distance' => $vector_distance,
+          'document' => $document,
+        ];
+
+        $i++;
+      }
+    }
+
+    if ($formatted_results !== []) {
+      $output = "Results from searching in the Typesense collections '" . \implode("', '", $this->collectionNames) . "' for the query: '{$this->searchQuery}'.\n\n";
+      $output .= \implode("\n", $formatted_results);
+      $this->setOutput($output);
+    }
+    else {
+      $this->setOutput("No meaningful content found in search results for query '{$this->searchQuery}' in collections '" . \implode("', '", $this->collectionNames) . "'.");
+    }
+  }
+
+  /**
+   * Extract meaningful content from document, excluding embedding fields.
+   *
+   * Processes a document from search results to extract human-readable
+   * content while filtering out embedding vectors and system fields.
+   *
+   * @param array<string, mixed> $document
+   *   The document data from search results.
+   *
+   * @return string
+   *   The formatted content string for the document.
+   */
+  private function extractDocumentContent(array $document): string {
+    $content_parts = [];
+
+    foreach ($document as $field_name => $value) {
+      // Skip embedding fields (float arrays) and system fields.
+      if (\is_array($value) && isset($value[0]) && \is_float($value[0])) {
+        continue;
+      }
+      if (\in_array($field_name, ['id', '.out'], TRUE)) {
+        continue;
+      }
+
+      // Convert arrays to readable format.
+      if (\is_array($value)) {
+        $value = \implode(', ', $value);
+      }
+
+      // Add field content.
+      if ($value !== '' && $value !== NULL) {
+        $content_parts[] = "$field_name: $value";
+      }
+    }
+
+    return \implode("\n", $content_parts);
+  }
+
+  /**
+   * {@inheritdoc}
+   *
+   * Returns structured output containing search results, collection name,
+   * and search query for programmatic access.
+   *
+   * @return array<string, mixed>
+   *   The structured output data.
+   */
+  public function getStructuredOutput(): array {
+    return [
+      'results' => $this->results,
+      'collection_names' => \implode(', ', $this->collectionNames),
+      'search_query' => $this->searchQuery,
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   *
+   * Sets structured output data from a provided array, typically used
+   * for restoring state from serialized data.
+   *
+   * @param array<array-key, mixed> $output
+   *   The structured output data containing results, collection_name,
+   *   and search_query.
+   */
+  public function setStructuredOutput(array $output): void {
+    $this->results = $output['results'] ?? [];
+    $this->collectionNames = \explode(', ', $output['collection_names'] ?? []);
+    $this->searchQuery = $output['search_query'] ?? '';
+  }
+
+}
diff --git a/src/Plugin/search_api/backend/SearchApiTypesenseBackend.php b/src/Plugin/search_api/backend/SearchApiTypesenseBackend.php
index d3655ca..2b0cb97 100644
--- a/src/Plugin/search_api/backend/SearchApiTypesenseBackend.php
+++ b/src/Plugin/search_api/backend/SearchApiTypesenseBackend.php
@@ -324,7 +324,7 @@ class SearchApiTypesenseBackend extends BackendPluginBase implements PluginFormI
    * @param \Drupal\search_api\IndexInterface $index
    *   The Search API index for which to retrieve the facets.
