+### Custom AI Chatbot
+
+```php
+<?php
+
+/**
+ * Example service for a RAG-powered chatbot.
+ */
+class ExampleRagChatbot {
+
+  public function __construct(
+    private readonly PluginManagerInterface $functionCallManager,
+    private readonly AiProviderManager $aiProviderManager,
+  ) {}
+
+  public function processQuery(string $user_query): string {
+    // First, search for relevant context
+    $rag_plugin = $this->functionCallManager->createInstance('search_api_typesense:rag_search');
+    $rag_plugin->setContextValue('collection_name', 'knowledge_base');
+    $rag_plugin->setContextValue('search_query', $user_query);
+    $rag_plugin->setContextValue('search_type', 'hybrid');
+    $rag_plugin->setContextValue('amount', 3);
+    $rag_plugin->execute();
+
+    $context = $rag_plugin->getStructuredOutput();
+
+    // Prepare context for AI
+    $context_text = '';
+    foreach ($context['results'] as $result) {
+      $context_text .= $result['document']['content'] . "\n\n";
+    }
+
+    // Generate response using AI with context
+    $ai_provider = $this->aiProviderManager->createInstance('openai');
+    $prompt = "Based on the following context, answer the user's question:\n\n" .
+              "Context:\n{$context_text}\n\n" .
+              "User Question: {$user_query}";
+
+    return $ai_provider->generateText($prompt);
+  }
+
+}
+```
+
+### Content Recommendation
+
+```php
+<?php
+
+/**
+ * Example of using RAG for content recommendations.
+ */
+class ExampleContentRecommender {
+
+  public function getRelatedContent(string $current_content_id, int $limit = 5): array {
+    // Get current content
+    $current_content = $this->loadContent($current_content_id);
+
+    // Use content title/summary as search query
+    $search_query = $current_content['title'] . ' ' . $current_content['summary'];
+
+    $plugin_manager = \Drupal::service('plugin.manager.ai_function_call');
+    $plugin = $plugin_manager->createInstance('search_api_typesense:rag_search');
+
+    $plugin->setContextValue('collection_name', 'content');
+    $plugin->setContextValue('search_query', $search_query);
+    $plugin->setContextValue('search_type', 'semantic');
+    $plugin->setContextValue('amount', $limit + 1); // +1 to exclude current
+    $plugin->setContextValue('distance_threshold', 0.8);
+
+    $plugin->execute();
+    $results = $plugin->getStructuredOutput();
+
+    // Filter out the current content
+    $recommendations = array_filter(
+      $results['results'],
+      fn($result) => $result['document']['id'] !== $current_content_id
+    );
+
+    return array_slice($recommendations, 0, $limit);
+  }
+
+}
+```
