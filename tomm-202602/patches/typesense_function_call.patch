diff --git a/src/Enum/SearchType.php b/src/Enum/SearchType.php
new file mode 100644
index 0000000..f9bd347
--- /dev/null
+++ b/src/Enum/SearchType.php
@@ -0,0 +1,81 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\search_api_typesense\Enum;
+
+/**
+ * Enum for Typesense search types.
+ *
+ * Defines the available search strategies for RAG (Retrieval-Augmented
+ * Generation) searches in Typesense.
+ */
+enum SearchType: string {
+
+  /*
+   * Semantic search using only vector embeddings.
+   *
+   * This search type relies purely on semantic similarity using auto-embedding
+   * fields. It disables prefix matching to ensure full query context is used
+   * for accurate embedding generation.
+   */
+  case Semantic = 'semantic';
+
+  /*
+   * Hybrid search combining semantic and keyword search.
+   *
+   * This search type combines vector similarity search with traditional
+   * keyword search for better relevance and coverage. It searches both
+   * embedding fields and text fields, and disables token dropping to preserve
+   * full query context for both semantic and keyword matching.
+   */
+  case Hybrid = 'hybrid';
+
+  /**
+   * Gets the default search type.
+   *
+   * @return self
+   *   The default search type (semantic).
+   */
+  public static function default(): self {
+    return self::Semantic;
+  }
+
+  /**
+   * Creates a SearchType from a string value.
+   *
+   * @param string|null $value
+   *   The string value to convert.
+   *
+   * @return self
+   *   The corresponding SearchType enum case.
+   *
+   * @throws \ValueError
+   *   When the value doesn't match any enum case.
+   */
+  public static function fromString(?string $value): self {
+    if ($value === NULL) {
+      return self::default();
+    }
+
+    return self::from($value);
+  }
+
+  /**
+   * Tries to create a SearchType from a string value.
+   *
+   * @param string|null $value
+   *   The string value to convert.
+   *
+   * @return self|null
+   *   The corresponding SearchType enum case, or NULL if invalid.
+   */
+  public static function tryFromString(?string $value): ?self {
+    if ($value === NULL) {
+      return self::default();
+    }
+
+    return self::tryFrom($value);
+  }
+
+}
