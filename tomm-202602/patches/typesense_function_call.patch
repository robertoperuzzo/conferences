+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\search_api_typesense\Functional\Plugin\AiFunctionCall;
+
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\search_api_typesense\Plugin\AiFunctionCall\TypesenseRagTool;
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Functional tests for the TypesenseRagTool plugin.
+ *
+ * These tests verify the plugin integration with the Drupal AI module
+ * and actual Typesense search functionality.
+ *
+ * @group search_api_typesense
+ * @requires module ai
+ */
+class TypesenseRagToolFunctionalTest extends BrowserTestBase {
+
+  use StringTranslationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Modules to install.
+   *
+   * @var array<string>
+   */
+  protected static $modules = [
+    'search_api',
+    'search_api_typesense',
+    'ai_agents',
+    'system',
+    'user',
+    'field',
+    'node',
+    'text',
+  ];
+
+  /**
+   * A user with permission to administer search.
+   *
+   * @var \Drupal\user\UserInterface
+   */
+  protected $adminUser;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    // Create an admin user.
+    $user = $this->drupalCreateUser([
+      'administer search_api',
+      'access administration pages',
+    ]);
+    $this::assertNotFalse($user, 'The admin user was created.');
+    $this->adminUser = $user;
+
+    $this->drupalLogin($this->adminUser);
+  }
+
+  /**
+   * Tests that the TypesenseRagTool plugin is available.
+   */
+  public function testPluginAvailability(): void {
+    // Check if the plugin is registered with the AI module.
+    $plugin_manager = $this->container->get('plugin.manager.ai.function_calls');
+    $plugin_definitions = $plugin_manager->getDefinitions();
+
+    $this::assertArrayHasKey('search_api_typesense:rag_search', $plugin_definitions);
+
+    $plugin_definition = $plugin_definitions['search_api_typesense:rag_search'];
+    $this::assertEquals('Search the relevant website contents in the selected Typesense collection using semantic/vector search.', $plugin_definition['description']);
+  }
+
+  /**
+   * Tests plugin instantiation and context definitions.
+   */
+  public function testPluginInstantiation(): void {
+    $plugin_manager = $this->container->get('plugin.manager.ai.function_calls');
+    $plugin = $plugin_manager->createInstance('search_api_typesense:rag_search');
+
+    $this::assertInstanceOf(TypesenseRagTool::class, $plugin);
+
+    // Check context definitions.
+    $context_definitions = $plugin->getContextDefinitions();
+
+    $expected_contexts = [
+      'collection_names',
+      'search_query',
+      'search_type',
+      'amount',
+      'distance_threshold',
+    ];
+
+    foreach ($expected_contexts as $context_name) {
+      $this::assertArrayHasKey($context_name, $context_definitions);
+    }
+
+    // Verify search_type has proper options.
+    $search_type_definition = $context_definitions['search_type'];
+    $this::assertFalse($search_type_definition->isRequired());
+    $this::assertEquals('string', $search_type_definition->getDataType());
+    $this::assertEquals('semantic', $search_type_definition->getDefaultValue());
+  }
+
+  /**
+   * Tests plugin execution with mock data.
+   *
+   * This test simulates plugin execution without requiring an actual
+   * Typesense server connection.
+   */
+  public function testPluginExecutionWithMockData(): void {
+    // This test would require more extensive mocking and setup.
+    // For now, we verify the plugin can be instantiated and configured.
+    $plugin_manager = $this->container->get('plugin.manager.ai.function_calls');
+
+    /** @var \Drupal\search_api_typesense\Plugin\AiFunctionCall\TypesenseRagTool $plugin */
+    $plugin = $plugin_manager->createInstance('search_api_typesense:rag_search');
+
+    // Set context values (collection_names supports comma-separated values).
+    $plugin->setContextValue('collection_names', 'test_collection');
+    $plugin->setContextValue('search_query', 'test query');
+    $plugin->setContextValue('search_type', 'semantic');
+    $plugin->setContextValue('amount', 5);
+    $plugin->setContextValue('distance_threshold', 0.5);
+
+    // Verify context values are set correctly.
+    $this::assertEquals('test_collection', $plugin->getContextValue('collection_names'));
+    $this::assertEquals('test query', $plugin->getContextValue('search_query'));
+    $this::assertEquals('semantic', $plugin->getContextValue('search_type'));
+    $this::assertEquals(5, $plugin->getContextValue('amount'));
+    $this::assertEquals(0.5, $plugin->getContextValue('distance_threshold'));
+  }
+
+  /**
+   * Tests plugin execution with multiple collections.
+   *
+   * This test verifies that the plugin can handle federated search
+   * across multiple collections with comma-separated names.
+   */
+  public function testPluginExecutionWithMultipleCollections(): void {
+    $plugin_manager = $this->container->get('plugin.manager.ai.function_calls');
+
+    /** @var \Drupal\search_api_typesense\Plugin\AiFunctionCall\TypesenseRagTool $plugin */
+    $plugin = $plugin_manager->createInstance('search_api_typesense:rag_search');
+
+    // Set context values with multiple collections.
+    $plugin->setContextValue('collection_names', 'collection1,collection2,collection3');
+    $plugin->setContextValue('search_query', 'test query');
+    $plugin->setContextValue('search_type', 'hybrid');
+    $plugin->setContextValue('amount', 10);
+    $plugin->setContextValue('distance_threshold', 0.8);
+
+    // Verify context values are set correctly.
+    $this::assertEquals('collection1,collection2,collection3', $plugin->getContextValue('collection_names'));
+    $this::assertEquals('test query', $plugin->getContextValue('search_query'));
+    $this::assertEquals('hybrid', $plugin->getContextValue('search_type'));
+    $this::assertEquals(10, $plugin->getContextValue('amount'));
+    $this::assertEquals(0.8, $plugin->getContextValue('distance_threshold'));
+  }
+
+}
