+
+  /**
+   * Tests error handling when collection is not found.
+   *
+   * @covers ::doSearch
+   * @covers ::execute
+   */
+  public function testCollectionNotFoundError(): void {
+    $this->mockClient->expects($this::once())
+      ->method('retrieveCollectionInfo')
