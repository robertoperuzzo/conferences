+  /**
+   * Tests extractDocumentContent method.
+   *
+   * @covers ::extractDocumentContent
+   */
+  public function testExtractDocumentContent(): void {
+    $document = [
+      'id' => '123',
+      'title' => 'Test Title',
+      'content' => 'Test Content',
+      'content_embedding' => [0.1, 0.2, 0.3],
+      '.out' => ['system_field' => 'value'],
+    ];
+
+    $reflection = new \ReflectionClass($this->plugin);
+    $extractDocumentContentMethod = $reflection->getMethod('extractDocumentContent');
+    $extractDocumentContentMethod->setAccessible(TRUE);
+
+    $content = $extractDocumentContentMethod->invoke($this->plugin, $document);
+
+    // Should include title and content but exclude id, .out, and embedding.
+    $this::assertStringContainsString('title: Test Title', $content);
+    $this::assertStringContainsString('content: Test Content', $content);
+    $this::assertStringNotContainsString('id:', $content);
+    $this::assertStringNotContainsString('.out:', $content);
+    $this::assertStringNotContainsString('content_embedding:', $content);
+  }
