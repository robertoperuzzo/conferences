+use Drupal\search_api_typesense\Plugin\AiFunctionCall\TypesenseRagTool;
+
+/**
+ * Kernel tests for the TypesenseRagTool plugin.
+ *
+ * @group search_api_typesense
+ * @requires module ai
+ *
+ * @coversDefaultClass \Drupal\search_api_typesense\Plugin\AiFunctionCall\TypesenseRagTool
+ */
+class TypesenseRagToolKernelTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'search_api',
+    'search_api_typesense',
+    'ai',
+    'system',
+    'user',
+  ];
+
+  /**
+   * The plugin under test.
+   *
+   * @var \Drupal\search_api_typesense\Plugin\AiFunctionCall\TypesenseRagTool
+   */
+  protected TypesenseRagTool $plugin;
+
+  /**
+   * Mock Typesense client.
+   *
+   * @var \Drupal\search_api_typesense\Api\TypesenseClientInterface|\PHPUnit\Framework\MockObject\MockObject
+   */
+  protected $mockClient;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->installConfig(['system']);
+
+    // Create mock Typesense client.
+    $this->mockClient = $this->createMock(TypesenseClientInterface::class);
+
+    // Get the plugin manager and create plugin instance.
+    $plugin_manager = $this->container->get('plugin.manager.ai.function_calls');
+    $this::assertInstanceOf(FunctionCallPluginManager::class, $plugin_manager);
+    $this->plugin = $plugin_manager->createInstance('search_api_typesense:rag_search');
+
+    // Inject the mock client.
+    $this->plugin->setTypesenseClient($this->mockClient);
+  }
+
+  /**
+   * Tests semantic search execution with single collection.
+   *
+   * @covers ::doSearch
+   * @covers ::execute
+   */
+  public function testSemanticSearchSingleCollection(): void {
+    // Mock collection info with embedding fields.
+    $collectionInfo = [
+      'fields' => [
+        [
+          'name' => 'content_embedding',
+          'type' => 'float[]',
+          'embed' => [
+            'from' => ['title', 'content'],
+            'model_config' => ['model_name' => 'ts/e5-small'],
+          ],
+        ],
+        [
+          'name' => 'title',
+          'type' => 'string',
+        ],
+        [
+          'name' => 'content',
+          'type' => 'string',
+        ],
+      ],
+    ];
+
+    $searchResults = [
+      'hits' => [
+        [
+          'document' => [
+            'title' => 'Test Document',
+            'content' => 'This is test content for semantic search',
+          ],
+          'vector_distance' => 0.3,
+        ],
+      ],
+    ];
+
+    // Setup mock expectations.
+    $this->mockClient->expects($this::once())
+      ->method('retrieveCollectionInfo')
+      ->with('test_collection')
+      ->willReturn($collectionInfo);
+
+    $this->mockClient->expects($this::once())
+      ->method('searchDocuments')
+      ->with(
+        'test_collection',
+        $this::callback(static function ($params) {
+          // Verify semantic search parameters.
+          return $params['q'] === 'test query' &&
+            $params['query_by'] === 'content_embedding' &&
+            $params['per_page'] === 5 &&
+            isset($params['prefix']) && $params['prefix'] === 'false' &&
+            isset($params['vector_query']) &&
+            \strpos($params['vector_query'], 'distance_threshold:0.5') !== FALSE &&
+            $params['exclude_fields'] === 'content_embedding';
+        }),
+      )
+      ->willReturn($searchResults);
+
+    // Set context and execute.
+    $this->plugin->setContextValue('collection_names', 'test_collection');
+    $this->plugin->setContextValue('search_query', 'test query');
+    $this->plugin->setContextValue('search_type', 'semantic');
+    $this->plugin->setContextValue('amount', 5);
+    $this->plugin->setContextValue('distance_threshold', 0.5);
+
+    $this->plugin->execute();
+
+    // Verify structured output.
+    $structuredOutput = $this->plugin->getStructuredOutput();
+    $this::assertArrayHasKey('results', $structuredOutput);
+    $this::assertArrayHasKey('collection_names', $structuredOutput);
+    $this::assertArrayHasKey('search_query', $structuredOutput);
+    $this::assertCount(1, $structuredOutput['results']);
+    $this::assertEquals('test_collection', $structuredOutput['collection_names']);
+    $this::assertEquals('test query', $structuredOutput['search_query']);
+    $this::assertEquals(0.3, $structuredOutput['results'][0]['vector_distance']);
+    $this::assertStringContainsString('Test Document', $structuredOutput['results'][0]['content']);
+  }
+
+  /**
+   * Tests hybrid search execution with single collection.
+   *
+   * @covers ::doSearch
+   * @covers ::execute
+   */
+  public function testHybridSearchSingleCollection(): void {
+    // Mock collection info with both embedding and text fields.
+    $collectionInfo = [
+      'fields' => [
+        [
+          'name' => 'content_embedding',
+          'type' => 'float[]',
+          'embed' => [
+            'from' => ['title', 'content'],
+            'model_config' => ['model_name' => 'ts/e5-small'],
+          ],
+        ],
+        [
+          'name' => 'title',
+          'type' => 'string',
+        ],
+        [
+          'name' => 'content',
+          'type' => 'string',
+        ],
+      ],
+    ];
+
+    $searchResults = [
+      'hits' => [
+        [
+          'document' => [
+            'title' => 'Hybrid Search Result',
+            'content' => 'Content matching both semantic and keyword search',
+          ],
+          'vector_distance' => 0.4,
+        ],
+      ],
+    ];
+
+    // Setup mock expectations.
+    $this->mockClient->expects($this::once())
+      ->method('retrieveCollectionInfo')
+      ->with('test_collection')
+      ->willReturn($collectionInfo);
+
+    $this->mockClient->expects($this::once())
+      ->method('searchDocuments')
+      ->with(
+        'test_collection',
+        $this::callback(static function ($params) {
+          // Verify hybrid search parameters include both embedding
+          // and text fields.
+          $query_by_fields = \explode(',', $params['query_by']);
+          return $params['q'] === 'test query' &&
+            \in_array('content_embedding', $query_by_fields, TRUE) &&
+            \in_array('title', $query_by_fields, TRUE) &&
+            \in_array('content', $query_by_fields, TRUE) &&
+            isset($params['drop_tokens_threshold']) &&
+            $params['drop_tokens_threshold'] === 0 &&
+            isset($params['vector_query']) &&
+            $params['exclude_fields'] === 'content_embedding';
+        }),
+      )
+      ->willReturn($searchResults);
+
+    // Set context and execute.
+    $this->plugin->setContextValue('collection_names', 'test_collection');
+    $this->plugin->setContextValue('search_query', 'test query');
+    $this->plugin->setContextValue('search_type', 'hybrid');
+    $this->plugin->setContextValue('amount', 10);
+    $this->plugin->setContextValue('distance_threshold', 1.0);
+
+    $this->plugin->execute();
+
+    // Verify structured output.
+    $structuredOutput = $this->plugin->getStructuredOutput();
+    $this::assertArrayHasKey('results', $structuredOutput);
+    $this::assertArrayHasKey('collection_names', $structuredOutput);
+    $this::assertArrayHasKey('search_query', $structuredOutput);
+    $this::assertCount(1, $structuredOutput['results']);
+    $this::assertEquals('test_collection', $structuredOutput['collection_names']);
+    $this::assertEquals('test query', $structuredOutput['search_query']);
+    $this::assertEquals(0.4, $structuredOutput['results'][0]['vector_distance']);
+    $this::assertArrayHasKey('document', $structuredOutput['results'][0]);
+    $this::assertEquals('Hybrid Search Result', $structuredOutput['results'][0]['document']['title']);
+  }
+
+  /**
+   * Tests federated search with multiple collections.
+   *
+   * @covers ::doSearch
+   * @covers ::execute
+   */
+  public function testFederatedSearchMultipleCollections(): void {
+    // Mock collection info for two collections.
+    $collectionInfo1 = [
+      'fields' => [
+        [
+          'name' => 'content_embedding',
+          'type' => 'float[]',
+          'embed' => ['from' => ['title']],
+        ],
+        [
+          'name' => 'title',
+          'type' => 'string',
+        ],
+      ],
+    ];
+
+    $collectionInfo2 = [
+      'fields' => [
+        [
+          'name' => 'content_embedding',
+          'type' => 'float[]',
+          'embed' => ['from' => ['content']],
+        ],
+        [
+          'name' => 'content',
+          'type' => 'string',
+        ],
+      ],
+    ];
+
+    $searchResults = [
+      'hits' => [
+        [
+          'document' => ['title' => 'Result from collection 1'],
+          'vector_distance' => 0.2,
+        ],
+        [
+          'document' => ['content' => 'Result from collection 2'],
+          'vector_distance' => 0.3,
+        ],
+      ],
+    ];
+
+    // Setup mock expectations for multiple retrieveCollectionInfo calls.
+    $this->mockClient->expects($this::exactly(2))
+      ->method('retrieveCollectionInfo')
+      ->willReturnCallback(static function ($collectionName) use ($collectionInfo1, $collectionInfo2) {
+        return match ($collectionName) {
+          'collection1' => $collectionInfo1,
+          'collection2' => $collectionInfo2,
+          default => NULL,
+        };
+      });
+
+    // Expect federated search call.
+    $this->mockClient->expects($this::once())
+      ->method('searchDocumentsWithFederation')
+      ->with(
+        ['collection1', 'collection2'],
+        $this::callback(static function ($params) {
+          // Verify search parameters.
+          return $params['q'] === 'test query' &&
+            $params['per_page'] === 10 &&
+            $params['query_by'] === 'content_embedding';
+        }),
+      )
+      ->willReturn($searchResults);
+
+    // Set context with multiple collections.
+    $this->plugin->setContextValue('collection_names', 'collection1,collection2');
+    $this->plugin->setContextValue('search_query', 'test query');
+    $this->plugin->setContextValue('search_type', 'semantic');
+    $this->plugin->setContextValue('amount', 10);
+    $this->plugin->setContextValue('distance_threshold', 1.5);
+
+    $this->plugin->execute();
+
+    // Verify structured output.
+    $structuredOutput = $this->plugin->getStructuredOutput();
+    $this::assertArrayHasKey('results', $structuredOutput);
+    $this::assertCount(2, $structuredOutput['results']);
+    $this::assertEquals('collection1, collection2', $structuredOutput['collection_names']);
+    $this::assertEquals('test query', $structuredOutput['search_query']);
+    $this::assertEquals(0.2, $structuredOutput['results'][0]['vector_distance']);
+    $this::assertEquals(0.3, $structuredOutput['results'][1]['vector_distance']);
+  }
+
+  /**
+   * Tests error handling when no embedding fields are configured.
+   *
+   * @covers ::doSearch
+   * @covers ::execute
+   */
+  public function testNoEmbeddingFieldsError(): void {
+    // Mock collection info without embedding fields.
+    $collectionInfo = [
+      'fields' => [
+        [
+          'name' => 'title',
+          'type' => 'string',
