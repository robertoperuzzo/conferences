+  label: 'Example RAG Provider'
+  plugin_id: openai
+  settings:
+    api_key: 'your-api-key'
+    model: 'gpt-4'
+    function_calls:
+      - 'search_api_typesense:rag_search'
+    system_role: |
+      You are a helpful assistant with access to a knowledge base.
+      When users ask questions, use the rag_search function to find
+      relevant information from the knowledge base before responding.
+```
